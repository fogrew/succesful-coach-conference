<section class='last-year section' id='last-year'>
  <div class='container'>
    <h2 class='heading-2'>Как это было</h2>
  </div>

  <div class='gallery' data-gallery>
    <div class='gallery__viewport'>
      <ul class='gallery__track'>
        {% for photo in index.lastYearPhotos %}
          <li class='gallery__item'>
            <button
              type='button'
              class='gallery__thumb'
              data-gallery-open
              data-alt='{{ photo.alt }}'
            >
              <img src='{{ photo.image }}' alt='{{ photo.alt }}' class='gallery__img' loading='lazy' draggable='false'>
            </button>
          </li>
        {% endfor %}
      </ul>
      <button type='button' class='gallery__nav gallery__nav--prev' data-track-prev aria-label='Предыдущее фото' hidden>&larr;</button>
      <button type='button' class='gallery__nav gallery__nav--next' data-track-next aria-label='Следующее фото' hidden>&rarr;</button>
    </div>
    <dialog class='gallery__dialog' data-gallery-dialog aria-label='Фото с прошлой конференции'>
      <button type='button' class='gallery__dialog-close' data-gallery-close aria-label='Закрыть' hidden>&times;</button>
      <div class='gallery__dialog-nav-row'>
        <button type='button' class='gallery__dialog-nav gallery__dialog-nav--prev' data-gallery-prev aria-label='Предыдущее фото'>&larr;</button>
        <button type='button' class='gallery__dialog-nav gallery__dialog-nav--next' data-gallery-next aria-label='Следующее фото'>&rarr;</button>
      </div>
      <img class='gallery__dialog-img' data-gallery-dialog-img alt=''>
      <div class='gallery__dialog-loader' data-gallery-loader hidden aria-hidden='true'>
        <span class='gallery__dialog-spinner'></span>
      </div>
    </dialog>
  </div>

  <div class='container'>
    <h3 class='heading-3'>Отзывы участников</h3>
  </div>

  <div class='gallery gallery--masonry' data-gallery>
    <ul class='gallery__masonry'>
      {% for review in index.reviews %}
        <li class='gallery__item'>
          <button
            type='button'
            class='gallery__thumb'
            data-gallery-open
            data-alt='{{ review.alt }}'
            data-link='{{ review.vkLink }}'
          >
            <img src='{{ review.image }}' alt='{{ review.alt }}' class='gallery__img' loading='lazy' draggable='false'>
          </button>
        </li>
      {% endfor %}
    </ul>
    <dialog class='gallery__dialog' data-gallery-dialog aria-label='Отзыв участника'>
      <button type='button' class='gallery__dialog-close' data-gallery-close aria-label='Закрыть' hidden>&times;</button>
      <div class='gallery__dialog-nav-row'>
        <button type='button' class='gallery__dialog-nav gallery__dialog-nav--prev' data-gallery-prev aria-label='Предыдущий отзыв'>&larr;</button>
        <button type='button' class='gallery__dialog-nav gallery__dialog-nav--next' data-gallery-next aria-label='Следующий отзыв'>&rarr;</button>
      </div>
      <img class='gallery__dialog-img' data-gallery-dialog-img alt=''>
      <div class='gallery__dialog-loader' data-gallery-loader hidden aria-hidden='true'>
        <span class='gallery__dialog-spinner'></span>
      </div>
      <a
        class='gallery__dialog-link'
        data-gallery-dialog-link
        target='_blank'
        rel='noopener noreferrer'
        hidden
      >Смотреть отзыв во ВКонтакте &rarr;</a>
    </dialog>
  </div>
</section>
