{% from '../nav.twig' import nav %}

<header class='header'>
  <div class='header__container container'>
    <button
      type='button'
      class='header__burger'
      data-header-burger
      aria-label='Открыть меню'
      aria-expanded='false'
      aria-controls='header-nav'
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <img src='/src/assets/images/logo.jpg' alt='CoachConf logo' class='header__logo' width='60' height='60'>
    {{ nav(common.nav, 'header__nav', 'header-nav') }}
    <div class='header__actions'>
      <a href='#pricing' class='button button--primary'>
        <span class='button__text'>Регистрация</span>
      </a>
    </div>
    <div class='header__scrim' data-header-scrim aria-hidden='true'></div>
  </div>
</header>
