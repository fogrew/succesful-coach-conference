{% macro nav(list, class, id) %}
<nav class='{{ ["nav", class] | join(' ') }}' {% if id %}id='{{ id }}'{% endif %}>
  <ul class='nav__list'>
    {% for item in list %}
      <li class='nav__item'>
        <a href='{{ item.link }}' class='nav__link'>{{ item.text }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
{% endmacro %}
